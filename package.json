  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "tsx --tsconfig scripts/tsconfig.json scripts/build-og.tsx",
    "dev": "next dev",
    "prebuild": "tsx scripts/validate-content.ts && tsx --tsconfig scripts/tsconfig.json scripts/build-og.tsx",
    "build": "next build",
    "postbuild": "tsx scripts/verify-export.ts",
    "preview": "python3 -m http.server 4173 --directory out",
